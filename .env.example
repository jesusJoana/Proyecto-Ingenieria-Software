# Copiar manualmente a .env.development, .env.test y .env.e2e.
# Ajustar APP_ENV, base, rol y puerto según el entorno. No compartir contraseñas ni secretos.
APP_ENV=development
DATABASE_URL=postgresql://refind_dev_user:SUSTITUIR@127.0.0.1:5432/refind_dev
# Generar un secreto distinto por entorno con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=SUSTITUIR_POR_SECRETO_LOCAL
# development 3000, e2e 3001, test 3002
PORT=3000

# --- Correo (opcional). Sin estas variables, el correo de recuperación de
# contraseña se escribe en la terminal del servidor (modo console).
# Dirección pública para construir los enlaces de los correos (por defecto http://localhost:PORT).
# APP_URL=http://localhost:3000
# console (por defecto) o smtp. En smtp son obligatorios SMTP_HOST y MAIL_FROM.
# MAIL_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=SUSTITUIR
# SMTP_PASS=SUSTITUIR
# MAIL_FROM=ReFind <SUSTITUIR@example.com>
