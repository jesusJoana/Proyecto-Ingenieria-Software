{
  "name": "proyecto-ingenieria-software",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto ReFind",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check:env": "node scripts/check-environment.js",
    "check:db": "node scripts/check-database.js",
    "check:tests": "npm run check:tests:http && npm run check:tests:browser",
    "check:tests:http": "vitest run --config vitest.setup.config.js --coverage",
    "check:tests:browser": "playwright test --config playwright.setup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jesusJoana/Proyecto-Ingenieria-Software.git"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bootstrap": "5.3.8",
    "connect-pg-simple": "10.0.0",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.1"
  }
}
