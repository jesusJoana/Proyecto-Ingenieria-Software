<%- include('partials/found-page-start',{section:'list'}) %>
<a href="/publicaciones">Volver a los hallazgos</a><section class="auth-panel p-4 mt-3"><h1><%= post.title %></h1>
<p><%= categories[post.category] %> · <strong><%= statuses[post.status] %></strong></p><p>Publicado por @<%= post.author_username %></p>
<dl><dt>Universidad y campus</dt><dd><%= post.university %> · <%= post.campus %></dd><dt>Zona general</dt><dd><%= post.general_area %></dd><dt>Fecha aproximada</dt><dd><%= post.found_from %><% if(post.found_until!==post.found_from){ %> – <%= post.found_until %><% } %></dd></dl>
<% if(post.campus_latitude!==null){ %><p>Referencia general del campus. No indica dónde está el objeto.</p><div class="location-map" data-found-map aria-label="Referencia general del campus"></div><span hidden data-map-point data-lat="<%= post.campus_latitude %>" data-lng="<%= post.campus_longitude %>" data-title="<%= post.campus %>"></span><% } %>
<% if(post.isAuthor){ %><section class="mt-4"><h2 class="h4">Tus datos privados</h2><p>Solo tú puedes ver esta información.</p><dl><dt>Detalles distintivos</dt><dd class="text-break" style="white-space:pre-wrap"><%= post.private.distinguishing_details %></dd><dt>Lugar exacto</dt><dd><%= post.private.exact_location||'No indicado' %></dd><dt>Dónde lo guardas</dt><dd><%= post.private.deposit_location||'No indicado' %></dd></dl><%- include('partials/private-position',{data:post.private}) %><% if(post.private.photo_key){ %><img class="img-fluid" style="max-height:360px" src="/publicaciones/<%= post.id %>/fotos/<%= post.private.photo_key %>" alt="Foto privada del hallazgo"><% } %></section>
<nav class="d-flex flex-wrap gap-3 mt-4" aria-label="Gestionar hallazgo"><% if(['available','reserved'].includes(post.status)){ %><a href="/publicaciones/<%= post.id %>/editar">Editar hallazgo</a><% } %><% if(post.status==='available'){ %><a href="/publicaciones/<%= post.id %>/retirar">Retirar hallazgo</a><% } %><a href="/publicaciones/<%= post.id %>/historial">Consultar versiones</a></nav>
<% } %><% if(!post.isAuthor&&post.status==='available'){ %><a class="btn btn-teal mt-3" href="/publicaciones/<%= post.id %>/reclamar">Reclamar objeto</a><% } %><% if(post.isAuthor){ %><p class="mt-3"><a href="/reclamaciones">Consultar mis reclamaciones y conversaciones</a></p><% } %></section><%- include('partials/found-page-end') %>
