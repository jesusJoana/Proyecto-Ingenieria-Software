<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/posts.css">
  <link rel="stylesheet" href="/css/design.css">
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <link rel="stylesheet" href="/css/locations.css">
</head>
<body class="home-page auth-page posts-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/posts-header', { current: null }) %>
  <% const formatDate = (value) => value.split('-').reverse().join('/');
     const publishedAt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Madrid' }).format(post.created_at); %>
  <main id="contenido" class="container auth-main posts-main">
    <p class="post-back"><a href="/publicaciones">← Volver a publicaciones</a></p>
    <% if (published) { %>
      <div class="alert alert-success" role="status">Tu publicación se ha creado correctamente.</div>
    <% } %>
    <% if (typeof locationSaved !== 'undefined' && locationSaved) { %><div class="alert alert-success" role="status">La ubicación se ha actualizado correctamente.</div><% } %>
    <% if (typeof edited !== 'undefined' && edited) { %><div class="alert alert-success" role="status">Los cambios se han guardado correctamente.</div><% } %>
    <% if (typeof statusSaved !== 'undefined' && statusSaved) { %><div class="alert alert-success" role="status">El estado de la publicación se ha actualizado.</div><% } %>
    <% if (post.status !== 'active') { %>
      <p class="post-status-note post-status-note-<%= post.status %>"><%= post.status === 'reserved' ? 'Reservada: alguien está en proceso de recuperar este objeto.' : 'Resuelta: este objeto ya se ha devuelto o encontrado.' %></p>
    <% } %>
    <article class="post-detail">
      <img class="post-detail-photo" src="<%= post.photo_filename ? '/uploads/posts/' + post.photo_filename : '/images/post-placeholder.svg' %>" alt="<%= post.photo_filename ? 'Foto de ' + post.title : 'Publicación sin foto' %>" width="600" height="450">
      <div class="post-detail-body">
        <div class="post-badges">
          <span class="post-kind post-kind-<%= post.kind %>"><%= kinds[post.kind] %></span>
          <span class="post-category"><%= categories[post.category] %></span>
          <span class="post-status post-status-<%= post.status %>"><%= statuses[post.status] %></span>
        </div>
        <h1><%= post.title %></h1>
        <% if (isAuthor) { %><%- include('partials/post-owner-actions', { post, back: 'detail' }) %><% } %>
        <p class="post-description"><%= post.description %></p>
        <dl class="post-facts">
          <div><dt>Tipo</dt><dd><%= kinds[post.kind] %></dd></div>
          <div><dt>Categoría</dt><dd><%= categories[post.category] %></dd></div>
          <div><dt><%= post.kind === 'lost' ? 'Último lugar conocido' : 'Lugar del hallazgo' %></dt><dd><%= post.location %></dd></div>
          <% if (post.university) { %>
            <div><dt>Universidad</dt><dd><%= post.university %></dd></div>
            <div><dt>Campus o sede</dt><dd><%= post.campus %></dd></div>
            <div><dt>Ciudad y país</dt><dd><%= post.city %>, <%= post.country %></dd></div>
            <div><dt>Dirección del campus</dt><dd><%= post.campus_address %></dd></div>
          <% } %>
          <% if (post.kind === 'found' && post.deposit_location) { %><div><dt>Depositado actualmente en</dt><dd><%= post.deposit_location %></dd></div><% } %>
          <div><dt><%= post.kind === 'lost' ? 'Fecha en que se perdió' : 'Fecha en que se encontró' %></dt><dd><%= formatDate(post.event_date) %></dd></div>
          <div><dt>Color</dt><dd><%= post.color ?? 'No indicado' %></dd></div>
          <div><dt>Marca</dt><dd><%= post.brand ?? 'No indicada' %></dd></div>
          <div><dt>Publicado</dt><dd><%= publishedAt %></dd></div>
        </dl>
        <section class="post-author" aria-labelledby="author-title">
          <h2 id="author-title" class="visually-hidden">Autor</h2>
          <% if (post.author_avatar_filename) { %><img class="post-author-avatar" src="/uploads/avatars/<%= post.author_avatar_filename %>" alt="" width="48" height="48"><% } else { %><span class="post-author-avatar post-author-placeholder" aria-hidden="true"><%= post.author_first_name.slice(0, 1).toUpperCase() %></span><% } %>
          <div>
            <p class="post-author-label"><%= isAuthor ? 'Publicado por ti' : 'Publicado por' %></p>
            <a href="/u/<%= encodeURIComponent(post.author_username) %>"><%= post.author_first_name %> <%= post.author_last_name %> <span>@<%= post.author_username %></span></a>
          </div>
        </section>
      </div>
    </article>
    <section class="post-location-panel" aria-labelledby="location-title">
      <h2 id="location-title">Ubicación</h2>
      <% if (isAuthor) { %><p><a href="/publicaciones/<%= post.id %>/ubicacion">Editar ubicación</a></p><% } %>
      <% if (post.latitude !== null && post.latitude !== undefined) { %>
        <p><%= post.location_mode === 'campus' ? 'Referencia general del campus; no indica el punto exacto del objeto.' : 'Punto exacto de la pérdida o del hallazgo indicado por el autor.' %></p>
        <p><%= post.university %> · <%= post.campus %> · <%= post.city %>, <%= post.country %></p>
        <div class="location-map" data-post-map data-lat="<%= post.latitude %>" data-lng="<%= post.longitude %>" data-mode="<%= post.location_mode %>" data-kind="<%= post.kind %>" data-label="<%= post.location %>" aria-label="Mapa de ubicación"></div>
        <p class="form-text">Coordenadas: <%= post.latitude %>, <%= post.longitude %></p>
        <a href="https://www.openstreetmap.org/?mlat=<%= post.latitude %>&amp;mlon=<%= post.longitude %>#map=17/<%= post.latitude %>/<%= post.longitude %>" target="_blank" rel="noopener noreferrer">Abrir ubicación en OpenStreetMap</a>
      <% } else { %><p>Esta publicación es anterior a las ubicaciones universitarias. Lugar indicado: <%= post.location %>.</p><% } %>
    </section>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/leaflet/leaflet.js" defer></script>
  <script src="/js/locations.js" defer></script>
</body>
</html>
