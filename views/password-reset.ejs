<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page auth-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/site-header', { current: 'auth' }) %>
  <main id="contenido" class="container auth-main">
    <div class="account-layout">
      <section class="auth-panel" aria-labelledby="reset-title">
        <div class="auth-form-heading">
          <span class="auth-kicker">Recuperar contraseña</span>
          <h1 id="reset-title"><%= title %></h1>
          <% if (valid) { %><p>Elige una nueva contraseña para tu cuenta.</p><% } %>
        </div>
        <% if (!valid) { %>
          <div class="alert alert-danger" role="alert">El enlace no es válido o ha caducado. Puede que ya se haya usado.</div>
          <a class="btn btn-teal w-100" href="/recuperar-contrasena">Solicitar un enlace nuevo</a>
        <% } else { %>
          <% if (Object.keys(errors).length) { %>
            <div class="alert alert-danger auth-errors" role="alert" tabindex="-1" id="form-errors">
              <strong>Revisa los campos indicados.</strong>
              <ul class="mb-0 mt-1">
                <% Object.entries(errors).forEach(([field, message]) => { %>
                  <li><a href="#<%= field %>"><%= message %></a></li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          <form action="/restablecer-contrasena/<%= token %>" method="post" class="auth-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="row g-3">
              <% [
                { id: 'password', label: 'Nueva contraseña', help: 'Entre 12 y 128 caracteres. Puedes utilizar una frase.' },
                { id: 'confirm_password', label: 'Confirmar nueva contraseña' }
              ].forEach(field => { %>
                <div class="col-12">
                  <label class="form-label" for="<%= field.id %>"><%= field.label %></label>
                  <div class="auth-input-wrap">
                    <input class="form-control <%= errors[field.id] ? 'is-invalid' : '' %>" id="<%= field.id %>" name="<%= field.id %>" type="password" autocomplete="new-password" maxlength="128" minlength="12" required value="" aria-invalid="<%= Boolean(errors[field.id]) %>" <% if (field.help || errors[field.id]) { %>aria-describedby="<%= [field.help ? field.id + '-help' : '', errors[field.id] ? field.id + '-error' : ''].filter(Boolean).join(' ') %>"<% } %>>
                    <button class="password-toggle" type="button" data-password-toggle="<%= field.id %>" aria-controls="<%= field.id %>" aria-label="Mostrar <%= field.label.toLowerCase() %>" aria-pressed="false" hidden>Ver</button>
                  </div>
                  <% if (field.help) { %><div class="form-text" id="<%= field.id %>-help"><%= field.help %></div><% } %>
                  <% if (errors[field.id]) { %><div class="invalid-feedback d-block" id="<%= field.id %>-error"><%= errors[field.id] %></div><% } %>
                </div>
              <% }); %>
            </div>
            <button class="btn btn-teal auth-submit w-100" type="submit">Guardar nueva contraseña <span aria-hidden="true">→</span></button>
          </form>
        <% } %>
        <p class="auth-switch"><a href="/iniciar-sesion">Volver a iniciar sesión</a></p>
      </section>
    </div>
  </main>
  <script src="/js/auth.js" defer></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
