<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="home-page auth-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <header class="site-header">
    <nav class="container d-flex align-items-center justify-content-between" aria-label="Navegación principal">
      <a class="brand" href="/" aria-label="ReFind, inicio"><svg class="icon brand-mark" aria-hidden="true"><use href="#icon-brand"></use></svg>ReFind</a>
      <a class="auth-home-link" href="/">Volver al inicio <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="contenido" class="container auth-main">
    <div class="account-layout">
      <section class="auth-panel" aria-labelledby="password-title">
        <div class="auth-form-heading">
          <span class="auth-kicker">Mi cuenta</span>
          <h1 id="password-title"><%= title %></h1>
          <p>Introduce tu contraseña actual y elige una nueva.</p>
        </div>
        <% if (changed) { %>
          <div class="alert alert-success" role="status">Tu contraseña se ha cambiado correctamente.</div>
        <% } %>
        <% if (Object.keys(errors).length) { %>
          <div class="alert alert-danger auth-errors" role="alert" tabindex="-1" id="form-errors">
            <strong>Revisa los campos indicados.</strong>
            <ul class="mb-0 mt-1">
              <% Object.entries(errors).forEach(([field, message]) => { %>
                <li><a href="#<%= field %>"><%= message %></a></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
        <form action="/cambiar-contrasena" method="post" class="auth-form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="row g-3">
            <% [
              { id: 'current_password', label: 'Contraseña actual', auto: 'current-password' },
              { id: 'new_password', label: 'Nueva contraseña', auto: 'new-password', min: 12, help: 'Entre 12 y 128 caracteres. Puedes utilizar una frase.' },
              { id: 'confirm_password', label: 'Confirmar nueva contraseña', auto: 'new-password', min: 12 }
            ].forEach(field => { %>
              <div class="col-12">
                <label class="form-label" for="<%= field.id %>"><%= field.label %></label>
                <div class="auth-input-wrap">
                  <input class="form-control <%= errors[field.id] ? 'is-invalid' : '' %>" id="<%= field.id %>" name="<%= field.id %>" type="password" autocomplete="<%= field.auto %>" maxlength="128" <% if (field.min) { %>minlength="<%= field.min %>"<% } %> required value="" aria-invalid="<%= Boolean(errors[field.id]) %>" <% if (field.help || errors[field.id]) { %>aria-describedby="<%= [field.help ? field.id + '-help' : '', errors[field.id] ? field.id + '-error' : ''].filter(Boolean).join(' ') %>"<% } %>>
                  <button class="password-toggle" type="button" data-password-toggle="<%= field.id %>" aria-controls="<%= field.id %>" aria-label="Mostrar <%= field.label.toLowerCase() %>" aria-pressed="false" hidden>Ver</button>
                </div>
                <% if (field.help) { %><div class="form-text" id="<%= field.id %>-help"><%= field.help %></div><% } %>
                <% if (errors[field.id]) { %><div class="invalid-feedback d-block" id="<%= field.id %>-error"><%= errors[field.id] %></div><% } %>
              </div>
            <% }); %>
          </div>
          <button class="btn btn-teal auth-submit w-100" type="submit">Cambiar contraseña <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch"><a href="/">Volver al inicio</a></p>
      </section>
    </div>
  </main>
  <script src="/js/auth.js" defer></script>
</body>
</html>
