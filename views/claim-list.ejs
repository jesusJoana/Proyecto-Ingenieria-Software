<%- include('partials/found-page-start',{section:'claims'}) %>
<p class="auth-kicker">Tus objetos y conversaciones</p><h1>Mis reclamaciones y conversaciones</h1><p>Incluye tus solicitudes y las recibidas por tus hallazgos. Cada conversación es privada entre sus dos participantes.</p>
<nav class="workflow-toolbar" aria-label="Accesos de reclamaciones"><a class="btn btn-outline-secondary" href="/publicaciones">Buscar objetos</a><a class="btn btn-outline-secondary" href="/actividad">Consultar mi historial</a></nav><% if(!claims.length){ %><p class="workflow-empty" role="status">Todavía no tienes reclamaciones.</p><% } %>
<% for(const claim of claims){ %><article class="auth-panel workflow-card"><h2 class="h5"><a class="text-break" href="/reclamaciones/<%= claim.id %>"><%= claim.title %></a></h2><p>Reclamación <%= claim.id %> · <span class="workflow-status" data-status="<%= claim.status %>"><%= statuses[claim.status] %></span></p><p>Conversación con @<%= claim.other_username %></p><div class="workflow-card-footer"><a class="btn btn-teal" href="/reclamaciones/<%= claim.id %>">Ver reclamación y conversar</a></div></article><% } %>
<nav class="workflow-pagination" aria-label="Páginas de conversaciones"><% if(page>1){ %><a class="btn btn-outline-secondary" href="/reclamaciones?page=<%= page-1 %>">Anterior</a><% } %> Página <%= page %> <% if(hasNext){ %><a class="btn btn-outline-secondary" href="/reclamaciones?page=<%= page+1 %>">Siguiente</a><% } %></nav>
<%- include('partials/found-page-end') %>
