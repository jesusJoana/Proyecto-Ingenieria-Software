<%- include('partials/found-page-start',{section:'claims'}) %>
<nav class="workflow-toolbar" aria-label="Volver a reclamaciones"><a class="btn btn-outline-secondary" href="/reclamaciones">Volver a mis reclamaciones</a><a class="btn btn-outline-secondary" href="#conversation">Ir a la conversación</a></nav><h1>Reclamación y conversación</h1><h2 class="h4"><a class="text-break" href="/publicaciones/<%= claim.object_id %>"><%= claim.title %></a></h2><p>Reclamación <%= claim.id %> · <span class="workflow-status" data-status="<%= claim.status %>" data-claim-status><%= statuses[claim.status] %></span></p><p>Autor: @<%= claim.author_username %> · Reclamante: @<%= claim.claimant_username %></p>
<div data-claim-actions data-revision="<%= new Date(claim.updated_at).toISOString() %>"><p data-action-update role="status" hidden>La reclamación ha cambiado. <a href="/reclamaciones/<%= claim.id %>">Actualizar las acciones</a>. Guarda tu borrador antes de actualizar.</p><%- include('partials/claim-actions') %></div>
<section class="auth-panel p-3"><h2 class="h5">Información aportada por el reclamante</h2><dl><% for(const [key,label] of [['description','Descripción'],['distinguishing_details','Detalles distintivos'],['lost_location','Lugar de pérdida']]){ %><dt><%= label %></dt><dd class="text-break" style="white-space:pre-wrap"><%= claim[key] %></dd><% } %><dt>Fecha de pérdida</dt><dd><%= claim.date_unknown?'No lo recuerda':claim.lost_from+(claim.lost_until!==claim.lost_from?' – '+claim.lost_until:'') %></dd></dl>
<% if(claim.previous_claim_id){ %><p><a class="btn btn-outline-secondary text-break" href="/reclamaciones/<%= claim.previous_claim_id %>">Consultar reclamación anterior</a></p><p class="text-break"><%= claim.additional_information %></p><% } %>
<% if(claim.decision_reason){ %><p class="text-break">Motivo: <%= claim.decision_reason %></p><% } %>
<ul class="workflow-files"><% for(const file of evidence){ %><li><a class="text-break" href="/reclamaciones/<%= claim.id %>/archivos/<%= file.storage_key %>"><%= file.original_name %></a></li><% } %></ul></section>
<section id="conversation" class="mt-4" data-claim-chat data-claim-id="<%= claim.id %>" data-after="<%= messages.at(-1)?.id||'0' %>" data-older="<%= older?'1':'0' %>"><h2>Conversación privada</h2>
<p>Solo podéis consultarla sus dos participantes.</p><% if(more&&messages.length){ %><a class="btn btn-outline-secondary text-break" href="/reclamaciones/<%= claim.id %>?before=<%= messages[0].id %>#conversation">Mensajes anteriores</a><% } %> <% if(older){ %><a class="btn btn-outline-secondary text-break" href="/reclamaciones/<%= claim.id %>#conversation">Volver a los últimos mensajes</a><% } %>
<div data-messages aria-live="polite"><% for(const message of messages){ %><article data-message-id="<%= message.id %>" class="auth-panel p-3 my-2"><p><strong>@<%= message.sender_username %></strong> · <time><%= new Date(message.created_at).toLocaleString('es-ES') %></time></p><p class="text-break" style="white-space:pre-wrap"><%= message.body %></p><ul><% for(const file of message.files){ %><li><a class="text-break" href="/reclamaciones/<%= claim.id %>/archivos/<%= file.storage_key %>"><%= file.original_name %></a></li><% } %></ul></article><% } %></div>
<p data-chat-notice role="status"><%= writable?'':'La conversación está cerrada y solo permite consulta.' %></p>
<% if(Object.keys(errors).length){ %><div class="alert alert-danger" role="alert"><% for(const message of Object.values(errors)){ %><p><%= message %></p><% } %></div><% } %>
<% if(writable){ %><form data-message-form method="post" action="/reclamaciones/<%= claim.id %>/mensajes" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="body" class="form-label">Mensaje</label><textarea id="body" name="body" rows="3" class="form-control" maxlength="2000" required><%= draft %></textarea><label for="attachments" class="form-label mt-3">Adjuntos del mensaje (opcionales)</label><input type="file" id="attachments" name="attachments" multiple class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf"><p class="form-text">Hasta 3 archivos de 5 MB. JPG, PNG, WebP o PDF. Imágenes hasta 20 megapíxeles.</p><button class="btn btn-teal mt-3" type="submit">Enviar mensaje</button></form><% } %>
</section><script src="/js/claim-chat.js" defer></script>
<%- include('partials/found-page-end') %>
