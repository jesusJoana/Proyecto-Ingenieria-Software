<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/posts.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page auth-page posts-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/posts-header', { current: mine ? 'mine' : 'list' }) %>
  <% const formatDate = (value) => value.split('-').reverse().join('/');
     const searching = !mine && (filters.q || filters.tipo || filters.categoria || filters.estado !== 'open'); %>
  <main id="contenido" class="container auth-main posts-main">
    <header class="posts-heading">
      <div>
        <p class="auth-kicker"><% if (!mine && accountUsername) { %>Hola, <%= accountUsername %> · <% } %><%= mine ? 'Tu actividad' : 'Objetos perdidos y encontrados' %></p>
        <h1><%= title %></h1>
        <p><%= mine ? 'Los objetos que has publicado, de los más recientes a los más antiguos.' : 'Las publicaciones más recientes de la comunidad.' %></p>
      </div>
      <% if (userId && posts.length) { %><a class="btn btn-teal" href="/publicaciones/nueva">Publicar objeto</a><% } %>
      <span class="posts-count"><%= posts.length %> <%= posts.length === 1 ? 'publicación' : 'publicaciones' %></span>
    </header>

    <% if (mine && typeof deleted !== 'undefined' && deleted) { %><div class="alert alert-success" role="status">La publicación se ha eliminado.</div><% } %>
    <% if (typeof statusSaved !== 'undefined' && statusSaved) { %><div class="alert alert-success" role="status">El estado de la publicación se ha actualizado.</div><% } %>

    <% if (!mine) { %>
      <form class="posts-tools posts-search" method="get" action="/publicaciones" role="search" aria-label="Buscar y filtrar publicaciones">
        <div class="posts-controls">
          <div><label class="form-label" for="posts-query">Buscar en título y descripción</label><input id="posts-query" name="q" type="search" class="form-control" maxlength="100" value="<%= filters.q %>" placeholder="Mochila, llaves, móvil…"></div>
          <div><label class="form-label" for="posts-kind">Tipo</label><select id="posts-kind" name="tipo" class="form-select"><option value="">Todos</option><% Object.entries(kinds).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.tipo === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
          <div><label class="form-label" for="posts-category">Categoría</label><select id="posts-category" name="categoria" class="form-select"><option value="">Todas</option><% Object.entries(categories).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.categoria === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
          <div><label class="form-label" for="posts-status">Estado</label><select id="posts-status" name="estado" class="form-select"><% Object.entries(statusFilters).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.estado === value ? 'selected' : '' %>><%= label %><%= value === 'open' ? ' (activas y reservadas)' : '' %></option><% }); %></select></div>
        </div>
        <div class="posts-search-actions">
          <button class="btn btn-teal" type="submit">Buscar</button>
          <% if (searching) { %><a href="/publicaciones">Limpiar filtros</a><% } %>
        </div>
        <% if (invalidFilters) { %><p class="form-text" role="status">Se han ignorado filtros no válidos de la dirección.</p><% } %>
        <% if (posts.length === searchLimit) { %><p class="posts-result-summary">Se muestran las <%= searchLimit %> publicaciones más recientes; concreta la búsqueda para ver otras.</p><% } %>
      </form>
    <% } %>

    <% if (!posts.length) { %>
      <div class="posts-empty">
        <% if (searching) { %>
          <p>No hay publicaciones que coincidan con la búsqueda.</p>
          <a class="btn btn-outline-secondary" href="/publicaciones">Limpiar filtros</a>
        <% } else { %>
          <p><%= mine ? 'Todavía no has publicado ningún objeto.' : 'Todavía no hay publicaciones.' %></p>
          <% if (userId) { %><a class="btn btn-teal" href="/publicaciones/nueva">Publicar objeto</a><% } %>
        <% } %>
      </div>
    <% } else { %>
      <ul class="posts-grid" aria-label="<%= title %>">
        <% posts.forEach(post => { %>
          <li data-post>
            <article class="post-card post-card-<%= post.status %>">
              <img class="post-card-photo" src="<%= post.photo_filename ? '/uploads/posts/' + post.photo_filename : '/images/post-placeholder.svg' %>" alt="" width="400" height="300" loading="lazy">
              <div class="post-card-body">
                <div class="post-badges">
                  <span class="post-kind post-kind-<%= post.kind %>"><%= kinds[post.kind] %></span>
                  <span class="post-category"><%= categories[post.category] %></span>
                  <span class="post-status post-status-<%= post.status %>"><%= statuses[post.status] %></span>
                </div>
                <h2><a class="stretched-link" href="/publicaciones/<%= post.id %>"><%= post.title %></a></h2>
                <p class="post-card-meta"><svg class="icon" aria-hidden="true"><use href="#icon-pin"></use></svg><%= post.location %> · <%= formatDate(post.event_date) %></p>
                <% if (post.university) { %><p class="post-card-meta"><%= post.university %> · <%= post.campus %> · <%= post.city %>, <%= post.country %></p><% } %>
                <% if (!mine) { %><p class="post-card-author">Publicado por @<%= post.author_username %></p><% } %>
                <% if (mine) { %><%- include('partials/post-owner-actions', { post, back: 'mine' }) %><% } %>
              </div>
            </article>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
