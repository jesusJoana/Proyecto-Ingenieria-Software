<%- include('partials/found-page-start',{section:mine?'mine':zones?'zones':'list'}) %>
<h1><%= title %></h1>
<% if(!mine){ %>
<p>Consulta datos generales. Los detalles de cada objeto se mantienen privados para verificar su propiedad.</p>
<form action="<%= zones?'/objetos-por-zonas':'/publicaciones' %>" method="get" class="row g-3 mb-4" role="search">
<% for(const [key,label,max] of [['q','Buscar objetos',100],['university','Universidad',180],['campus','Campus',180],['general_area','Zona general',150]]){ %><div class="col-md-6"><label for="filter-<%= key %>" class="form-label"><%= label %></label><input class="form-control" type="<%= key==='q'?'search':'text' %>" id="filter-<%= key %>" name="<%= key %>" value="<%= filters[key] %>" maxlength="<%= max %>"></div><% } %>
<div class="col-md-4"><label for="filter-category" class="form-label">Categoría</label><select class="form-select" id="filter-category" name="category"><option value="">Todas</option><% for(const [key,label] of Object.entries(categories)){ %><option value="<%= key %>" <%= filters.category===key?'selected':'' %>><%= label %></option><% } %></select></div>
<% for(const [key,label] of [['from','Desde'],['until','Hasta']]){ %><div class="col-md-4"><label for="filter-<%= key %>" class="form-label"><%= label %></label><input class="form-control" type="date" id="filter-<%= key %>" name="<%= key %>" value="<%= filters[key] %>"></div><% } %>
<div class="col-12"><button class="btn btn-teal" type="submit">Buscar</button> <a href="<%= zones?'/objetos-por-zonas':'/publicaciones' %>">Limpiar filtros</a></div></form>
<% if(invalidFilters){ %><p class="alert alert-warning">Se han descartado filtros no válidos.</p><% } %>
<% } %>
<% if(zones){ %><p>Referencias generales de campus, no ubicaciones exactas. <a href="<%= listUrl %>">Ver también hallazgos sin mapa</a>.</p><div class="location-map mb-3" data-found-map aria-label="Mapa de referencias generales"></div><% for(const post of posts){ %><span hidden data-map-point data-lat="<%= post.campus_latitude %>" data-lng="<%= post.campus_longitude %>" data-title="<%= post.title %>"></span><% } %><% } %>
<div class="row g-3"><% for(const post of posts){ %><div class="col-md-6 col-xl-4"><%- include('partials/found-card',{post}) %></div><% } %></div>
<% if(!posts.length){ %><p role="status" class="mt-3"><%= zones?'No hay hallazgos con referencia de campus en el mapa que coincidan con tu búsqueda. Consulta también el listado: puede haber objetos publicados sin mapa.':'No hay objetos que coincidan con tu búsqueda.' %></p><% } %>
<% if(!mine){ %><nav aria-label="Páginas de resultados" class="my-4"><% if(filters.page>1){ %><a href="<%= pageUrl(filters.page-1) %>">Anterior</a><% } %> <span>Página <%= filters.page %></span> <% if(hasNext){ %><a href="<%= pageUrl(filters.page+1) %>">Siguiente</a><% } %></nav><% } %>
<%- include('partials/found-page-end') %>
