<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page auth-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/site-header', { current: 'auth' }) %>
  <main id="contenido" class="container auth-main">
    <div class="account-layout">
      <section class="auth-panel" aria-labelledby="forgot-title">
        <div class="auth-form-heading">
          <span class="auth-kicker">¿Has olvidado tu contraseña?</span>
          <h1 id="forgot-title"><%= title %></h1>
          <p>Escribe el correo de tu cuenta y te enviaremos un enlace para elegir una nueva.</p>
        </div>
        <% if (sent) { %>
          <div class="alert alert-success" role="status">Si el correo está registrado, recibirás un enlace para restablecer la contraseña.</div>
          <p>El enlace vale durante 1 hora y solo se puede usar una vez. Si no lo encuentras, revisa la carpeta de correo no deseado.</p>
        <% } else { %>
          <% if (Object.keys(errors).length) { %>
            <div class="alert alert-danger auth-errors" role="alert" tabindex="-1" id="form-errors">
              <strong>Revisa los campos indicados.</strong>
              <ul class="mb-0 mt-1">
                <% Object.entries(errors).forEach(([field, message]) => { %>
                  <li><a href="#<%= field %>"><%= message %></a></li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          <form action="/recuperar-contrasena" method="post" class="auth-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="form-label" for="email">Correo electrónico</label>
            <input class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" type="email" autocomplete="email" maxlength="254" required value="<%= email %>" aria-invalid="<%= Boolean(errors.email) %>" <% if (errors.email) { %>aria-describedby="email-error"<% } %>>
            <% if (errors.email) { %><div class="invalid-feedback d-block" id="email-error"><%= errors.email %></div><% } %>
            <button class="btn btn-teal auth-submit w-100" type="submit">Enviar enlace <span aria-hidden="true">→</span></button>
          </form>
        <% } %>
        <p class="auth-switch"><a href="/iniciar-sesion">Volver a iniciar sesión</a></p>
      </section>
    </div>
  </main>
  <script src="/js/auth.js" defer></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
