<%- include('partials/found-page-start',{section:'claims'}) %>
<section class="auth-panel post-form-panel p-4"><h1>Reclamar objeto</h1><h2 class="h5"><%= info.object.title %></h2>
<p>Explica cómo reconocerías tu objeto. Solo la persona que publicó el hallazgo y tú podréis consultar esta información. No incluyas contraseñas, PIN, documentos de identidad completos ni datos bancarios.</p>
<% if(Object.keys(errors).length){ %><div role="alert" class="alert alert-danger"><ul><% for(const [key,text] of Object.entries(errors)){ %><li><a href="#<%= key %>"><%= ({description:'Descripción',distinguishing_details:'Detalles distintivos',lost_location:'Lugar de pérdida',lost_from:'Fecha inicial',lost_until:'Fecha final',date_unknown:'Fecha desconocida',additional_information:'Información adicional',attachments:'Adjuntos'})[key]||key %>: <%= text %></a></li><% } %></ul></div><% } %>
<form method="post" action="/publicaciones/<%= info.object.id %>/reclamar" enctype="multipart/form-data" novalidate>
<input type="hidden" name="_csrf" value="<%= csrf %>">
<% for(const [key,label] of [['description','Descripción del objeto'],['distinguishing_details','Detalles distintivos que recuerdas']]){ %><div class="mb-3"><label class="form-label" for="<%= key %>"><%= label %></label><textarea class="form-control" id="<%= key %>" name="<%= key %>" rows="3" minlength="10" maxlength="2000" required><%= values[key] %></textarea><p class="form-text">De 10 a 2000 caracteres. Marca, modelo y color no son obligatorios por separado.</p></div><% } %>
<label for="lost_location" class="form-label">Dónde lo perdiste</label><input class="form-control mb-3" id="lost_location" name="lost_location" minlength="2" maxlength="250" required value="<%= values.lost_location %>">
<fieldset><legend class="h5">Fecha aproximada de pérdida</legend><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="date_unknown" name="date_unknown" value="1" <%= values.date_unknown==='1'?'checked':'' %>><label class="form-check-label" for="date_unknown">No lo recuerdo</label></div><div class="row"><% for(const [key,label] of [['lost_from','Fecha desde'],['lost_until','Fecha hasta (opcional)']]){ %><div class="col-md-6"><label for="<%= key %>" class="form-label"><%= label %></label><input class="form-control" type="date" id="<%= key %>" name="<%= key %>" value="<%= values[key] %>" max="<%= maxDate %>"></div><% } %></div><p class="form-text">Para un único día, deja la fecha final vacía. Si marcas «No lo recuerdo», se ignoran las fechas.</p></fieldset>
<% if(info.previous){ %><p>Existe una reclamación anterior. <a href="/reclamaciones/<%= info.previous.id %>">Consultar antecedente</a>.</p><label for="additional_information" class="form-label">Qué información adicional aportas</label><textarea id="additional_information" name="additional_information" class="form-control mb-3" minlength="10" maxlength="2000" required><%= values.additional_information %></textarea><p class="form-text">Explica qué datos o pruebas nuevas aportas. No es obligatorio adjuntar un archivo.</p><% } %>
<label for="attachments" class="form-label">Pruebas adjuntas (opcionales)</label><input class="form-control" type="file" id="attachments" name="attachments" multiple accept="image/jpeg,image/png,image/webp,application/pdf"><p class="form-text">Hasta 3 archivos JPG, PNG, WebP o PDF de 5 MB cada uno. Imágenes hasta 20 megapíxeles.</p>
<button type="submit" class="btn btn-teal mt-3">Enviar reclamación</button></form></section>
<%- include('partials/found-page-end') %>
