<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Perfil público ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page auth-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/site-header', { current: 'profile' }) %>
  <main id="contenido" class="container auth-main">
    <section class="public-profile-card" aria-labelledby="profile-title">
      <p class="auth-kicker">Perfil público</p>
      <h1 id="profile-title">@<%= profile.username %></h1>
    </section>
      <a class="btn btn-teal mt-4" href="/">Volver a ReFind</a>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
