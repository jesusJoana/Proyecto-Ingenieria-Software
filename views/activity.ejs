<%- include('partials/found-page-start',{section:path==='/avisos'?'notifications':'activity'}) %>
<p class="auth-kicker">Seguimiento de tus hallazgos</p><h1><%= title %></h1>
<p><%= path==='/avisos'?'Novedades de tus objetos y reclamaciones. Consulta cada aviso, márcalo como leído o elimínalo de tu bandeja.':'Consulta las decisiones y los cambios de estado de tus objetos y reclamaciones.' %></p>
<nav class="workflow-toolbar" aria-label="Actividad personal"><a class="btn btn-outline-secondary" href="/actividad" <%- path==='/actividad'?'aria-current="page"':'' %>>Mi historial</a><a class="btn btn-outline-secondary" href="/avisos" <%- path==='/avisos'?'aria-current="page"':'' %>>Mis avisos</a><a class="btn btn-outline-secondary" href="/reclamaciones">Mis reclamaciones</a><a class="btn btn-outline-secondary" href="/mis-publicaciones">Mis publicaciones</a></nav>
<% if(path==='/avisos'){ %><form method="post" action="/avisos/eliminar-leidos" class="workflow-toolbar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-danger">Eliminar todos los leídos</button></form><% } %>
<% if(!items.length){ %><p class="workflow-empty">Todavía no hay actividad en esta página.</p><% } %>
<% for(const item of items){ %><article class="auth-panel workflow-card <%= item.notification_id&&!item.read_at?'unread':'' %>"><h2><%= labels[item.action]||'Actividad del hallazgo' %></h2><p class="text-break"><%= item.title %></p><time><%= new Date(item.created_at).toLocaleString('es-ES') %></time><% if(item.reason){ %><p class="text-break">Motivo: <%= item.reason %></p><% } %><div class="workflow-card-footer"><a class="btn btn-teal" href="<%= item.claim_id?'/reclamaciones/'+item.claim_id:'/publicaciones/'+item.object_id %>"><%= item.claim_id?'Ver reclamación':'Ver hallazgo' %></a><% if(item.notification_id){ %><% if(item.read_at){ %><span class="workflow-status">Leído</span><% }else{ %><form method="post" action="/avisos/<%= item.notification_id %>/leido"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-secondary">Marcar como leído</button></form><% } %><form method="post" action="/avisos/<%= item.notification_id %>/eliminar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-danger">Eliminar aviso</button></form><% } %></div></article><% } %>
<nav class="workflow-pagination" aria-label="Paginación"><% if(page>1){ %><a class="btn btn-outline-secondary" href="<%= path %>?page=<%= page-1 %>">Anterior</a><% } %> <% if(hasNext){ %><a class="btn btn-outline-secondary" href="<%= path %>?page=<%= page+1 %>">Siguiente</a><% } %></nav>
<%- include('partials/found-page-end') %>
