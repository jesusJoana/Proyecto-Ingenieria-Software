<%- include('partials/found-page-start',{section:'mine'}) %>
<section class="auth-panel p-4"><h1>Retirar hallazgo</h1><h2 class="h5"><%= post.title %></h2><p>Dejará de aparecer en las búsquedas. Conservarás el historial y no podrás reactivarlo.</p>
<% if(Object.keys(errors).length){ %><div class="alert alert-danger" role="alert"><% for(const message of Object.values(errors)){ %><p><%= message %></p><% } %></div><% } %>
<form method="post" action="/publicaciones/<%= post.id %>/retirar"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="reason" class="form-label">Motivo de la retirada</label><textarea id="reason" name="reason" class="form-control" required minlength="2" maxlength="1000"><%= values.reason||'' %></textarea><div class="form-check my-3"><input class="form-check-input" type="checkbox" name="confirm" id="confirm" value="1" required><label for="confirm" class="form-check-label">Confirmo la retirada del hallazgo</label></div><button type="submit" class="btn btn-danger">Retirar hallazgo</button> <a href="/publicaciones/<%= post.id %>">Volver</a></form></section><%- include('partials/found-page-end') %>
