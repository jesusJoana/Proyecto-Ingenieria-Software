<%- include('partials/found-page-start',{section:'mine'}) %>
<h1>Versiones del hallazgo</h1><p>Este historial, incluidos sus detalles y fotografías, solo es visible para ti.</p><a href="/publicaciones/<%= post.id %>">Volver al hallazgo</a>
<% for(const v of versions){ %><article class="auth-panel p-3 mt-3"><h2 class="h4">Versión <%= v.version %></h2><p><%= new Date(v.created_at).toLocaleString('es-ES') %></p><dl><dt>Categoría</dt><dd><%= categories[v.public_data.category] || v.public_data.category %></dd><dt>Referencia aproximada del campus</dt><dd><%= v.public_data.campus_latitude==null?'No indicada':v.public_data.campus_latitude+', '+v.public_data.campus_longitude %></dd><% for(const [key,label] of [['object_type','Tipo general'],['university','Universidad'],['campus','Campus'],['general_area','Zona general'],['found_from','Desde'],['found_until','Hasta']]){ %><dt><%= label %></dt><dd><%= v.public_data[key] %></dd><% } %><% for(const [key,label] of [['distinguishing_details','Detalles privados'],['exact_location','Lugar exacto'],['deposit_location','Depósito']]){ %><dt><%= label %></dt><dd class="text-break"><%= v.private_data[key]||'No indicado' %></dd><% } %></dl><% if(v.private_data.photo_key){ %><img class="img-fluid" style="max-height:250px" src="/publicaciones/<%= post.id %>/fotos/<%= v.private_data.photo_key %>" alt="Foto privada de la versión <%= v.version %>"><% } %></article><% } %>
<%- include('partials/found-page-end') %>
