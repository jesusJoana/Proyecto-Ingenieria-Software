<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ReFind</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page auth-page account-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <%- include('partials/site-header', { current: 'profile' }) %>
  <main id="contenido" class="container auth-main profile-main">
<nav class="profile-tabs" aria-label="Secciones de tu cuenta"><a href="/perfil" aria-current="page">Mi perfil</a><a href="/perfil/editar" >Editar perfil</a></nav><section class="profile-overview" aria-labelledby="profile-title"><div class="profile-cover"><span>Tu comunidad, más cerca</span></div><div class="profile-overview-body"><div class="profile-identity"><div class="profile-avatar-preview"><% if (avatarFilename) { %><img src="/uploads/avatars/<%= avatarFilename %>" alt="Foto de perfil" width="112" height="112"><% } else { %><span class="profile-avatar-placeholder" aria-hidden="true"><%= (values.first_name || 'R').slice(0,1).toUpperCase() %></span><% } %></div><div><p class="auth-kicker">Mi perfil</p><h1 id="profile-title"><%= values.first_name %> <%= values.last_name %></h1><p class="profile-handle">@<%= values.username %></p></div><a class="btn btn-teal profile-edit-button" href="/perfil/editar">Editar perfil ↗</a></div><p class="profile-bio"><%= values.description || 'Puedes completar tus datos privados desde Editar perfil.' %></p><dl class="profile-facts"><div><dt>Localidad</dt><dd><%= values.locality || 'Sin indicar' %></dd></div><div><dt>Organización</dt><dd><%= values.organization || 'Sin indicar' %></dd></div><% if (values.age) { %><div><dt>Edad</dt><dd><%= values.age %> años</dd></div><% } %></dl></div></section><div class="profile-stats" aria-label="Resumen de actividad"><div><strong><%= activitySummary.publications %></strong><span>Hallazgos publicados</span></div><div><strong><%= activitySummary.active %></strong><span>Reclamaciones activas</span></div><div><strong><%= activitySummary.completed %></strong><span>Devoluciones completadas</span></div></div>
<nav aria-label="Mi actividad"><a href="/mis-publicaciones">Mis publicaciones</a> · <a href="/reclamaciones">Mis reclamaciones</a> · <a href="/actividad">Mi historial</a> · <a href="/avisos">Mis avisos</a></nav>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
