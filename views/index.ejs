<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Encuentra objetos perdidos y ayuda a que vuelvan a su dueño en tu universidad.">
  <title><%= title %> · Objetos que vuelven a historias</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/refind.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body class="home-page">
  <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
  <%- include('partials/icons') %>
  <% const icon = (name, extra = '') => '<svg class="icon ' + extra + '" aria-hidden="true"><use href="#icon-' + name + '"></use></svg>'; %>
  <% // Ejemplos visuales; todavía no son publicaciones obtenidas de PostgreSQL.
  const objects = [
    { title: 'Mochila negra', image: 'backpack', status: 'found', label: 'Encontrada', place: 'Biblioteca', time: 'hace 2 horas' },
    { title: 'Llaves con llavero azul', image: 'keys', status: 'lost', label: 'Perdidas', place: 'Cafetería', time: 'hace 5 horas' },
    { title: 'Auriculares inalámbricos', image: 'earbuds', status: 'found', label: 'Encontrados', place: 'Aula 2.3', time: 'hace 1 día' }
  ]; %>
  <%- include('partials/site-header', { current: 'home' }) %>
  <main id="contenido">

    <section class="welcome-hero" aria-labelledby="hero-title">
      <div class="container welcome-layout">
        <div class="welcome-copy">
          <p class="eyebrow">Tu comunidad universitaria</p>
          <h1 id="hero-title">Objetos que<br>vuelven a historias</h1>
          <p class="welcome-description">ReFind es la plataforma universitaria para publicar y buscar objetos perdidos o encontrados. Juntos hacemos que lo que pierdes vuelva a su dueño.</p>
          <div class="welcome-actions">
            <% if (userId) { %>
              <a class="btn btn-teal" href="/publicaciones">Buscar objetos <%- icon('search') %></a>
              <a class="btn btn-outline-secondary" href="/publicaciones/nueva">Publicar objeto</a>
            <% } else { %>
              <a class="btn btn-teal" href="/registro">Registrarse <%- icon('arrow') %></a>
              <a class="btn btn-outline-secondary" href="/iniciar-sesion">Iniciar sesión</a>
            <% } %>
          </div>
          <div class="welcome-values">
            <span><%- icon('users') %>Comunidad<br>universitaria</span>
            <span><%- icon('shield') %>Seguro<br>y confiable</span>
            <span><%- icon('leaf') %>Más sostenible</span>
          </div>
        </div>
        <div class="welcome-photo">
          <img class="welcome-campus" src="/images/campus.webp" alt="Patio universitario con jardines y soportales" fetchpriority="high">
          <div class="floating-objects" aria-hidden="true">
            <% objects.forEach(object => { %>
              <div class="floating-object"><img src="/images/<%= object.image %>.webp" alt=""><div><strong><%= object.title %></strong><span><%= object.label %></span><small><%= object.place %></small></div></div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
    <section class="container how-section" id="como-funciona" aria-labelledby="how-title">
      <div><h2 id="how-title">¿Cómo funciona?</h2><p>Recuperar un objeto es muy sencillo.</p></div>
      <article><span class="step-icon"><%- icon('plus') %></span><div><small>01</small><h3>Publica</h3><p>Describe el objeto perdido o encontrado y añade una foto.</p></div></article>
      <article><span class="step-icon"><%- icon('search') %></span><div><small>02</small><h3>Busca</h3><p>Consulta los objetos publicados por la comunidad.</p></div></article>
      <article><span class="step-icon"><%- icon('users') %></span><div><small>03</small><h3>Conecta</h3><p>Contacta con la persona y ayuda a recuperar el objeto.</p></div></article>
    </section>
    <section class="container about-section" id="sobre-nosotros" aria-labelledby="about-title">
      <img src="/images/campus.webp" alt="Un espacio de encuentro en la universidad" loading="lazy">
      <div><p class="eyebrow">Sobre ReFind</p><h2 id="about-title">Una pequeña acción,<br>un gran impacto</h2><p>ReFind nace con una idea sencilla: facilitar que los objetos perdidos dentro de la universidad vuelvan a sus propietarios. Una comunidad más conectada, responsable y sostenible, donde colaborar hace la vida universitaria un poco mejor.</p></div>
    </section>
    <div class="container home-content">
      <section class="row g-4 action-cards" aria-label="Publicar un objeto">
        <div class="col-md-6">
          <article class="action-card lost-card h-100">
            <div class="action-icon"><%- icon('backpack') %></div>
            <div>
              <h2>He perdido un objeto</h2>
              <p>Publica lo que has perdido para encontrar coincidencias.</p>
              <a class="btn btn-indigo" href="/publicaciones/nueva?tipo=perdido">Publicar objeto perdido <%- icon('arrow') %></a>
            </div>
          </article>
        </div>
        <div class="col-md-6">
          <article class="action-card found-card h-100">
            <div class="action-icon"><%- icon('key') %></div>
            <div>
              <h2>He encontrado un objeto</h2>
              <p>Ayuda a devolver un objeto a su propietario.</p>
              <a class="btn btn-teal" href="/publicaciones/nueva?tipo=encontrado">Publicar objeto encontrado <%- icon('arrow') %></a>
            </div>
          </article>
        </div>
      </section>
      <section class="recent-section" aria-labelledby="recent-title">
        <div class="d-flex align-items-center justify-content-between recent-heading">
          <div class="d-flex align-items-center flex-wrap gap-2 gap-sm-3"><h2 id="recent-title">Objetos recientes</h2><span class="example-badge">Ejemplos</span></div>
          <button id="show-all" class="btn view-all" type="button">Ver todos <%- icon('arrow') %></button>
        </div>
            <form id="object-search" class="search-box" role="search">
              <label for="search-query" class="visually-hidden">Buscar objetos de ejemplo</label>
              <%- icon('search') %>
              <input id="search-query" class="form-control" type="search" placeholder="Buscar mochila, llaves, móvil..." autocomplete="off" maxlength="120">
              <button class="btn btn-indigo" type="submit">Buscar</button>
            </form>
            <div class="filter-group d-flex gap-2" role="group" aria-label="Filtrar objetos por estado">
              <button type="button" class="btn filter-button active" data-filter="all" aria-pressed="true">Todos</button>
              <button type="button" class="btn filter-button" data-filter="lost" aria-pressed="false">Perdidos</button>
              <button type="button" class="btn filter-button" data-filter="found" aria-pressed="false">Encontrados</button>
            </div>
        <p id="search-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">3 objetos de ejemplo.</p>
        <div class="row g-3">
          <% objects.forEach(object => { %>
            <div class="col-md-4" data-object-card data-status="<%= object.status %>" data-search="<%= object.title %> <%= object.place %>">
              <button class="object-card w-100" type="button" data-bs-toggle="modal" data-bs-target="#infoModal" data-action="object" data-title="<%= object.title %>" data-place="<%= object.place %>">
                <img src="/images/<%= object.image %>.webp" alt="" width="76" height="76">
                <span class="object-info">
                  <strong><%= object.title %></strong>
                  <span class="object-meta"><span class="status-dot <%= object.status %>"></span><%= object.label %> · <%= object.place %></span>
                  <span class="object-time"><%= object.time %></span>
                </span>
              </button>
            </div>
          <% }); %>
        </div>
        <p id="empty-results" class="empty-results" hidden>No hay objetos que coincidan con tu búsqueda.</p>
        <noscript><p class="mt-3">Activa JavaScript para buscar y filtrar los ejemplos de esta portada.</p></noscript>
      </section>
    </div>
  </main>
  <footer class="site-footer">
    <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
      <div class="footer-identity d-flex align-items-center"><a class="brand" href="/" aria-label="ReFind, inicio"><%- icon('brand', 'brand-mark') %>ReFind</a><span>Objetos que vuelven a historias</span></div>
      <nav class="d-flex gap-4" aria-label="Información">
        <% [['privacy', 'Privacidad'], ['contact', 'Contacto'], ['terms', 'Términos']].forEach(([action, label]) => { %>
          <button class="footer-link" type="button" data-bs-toggle="modal" data-bs-target="#infoModal" data-action="<%= action %>"><%= label %></button>
        <% }); %>
      </nav>
    </div>
  </footer>
  <div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="info-title" aria-describedby="info-description" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="info-title">ReFind</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
        <div class="modal-body"><p id="info-description" class="mb-0"></p></div>
        <div class="modal-footer"><button class="btn btn-teal" type="button" data-bs-dismiss="modal">Entendido</button></div>
      </div>
    </div>
  </div>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/home.js" defer></script>
</body>
</html>
